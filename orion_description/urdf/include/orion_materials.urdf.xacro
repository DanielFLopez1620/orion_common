<?xml version="1.0"?>
<!-- @file orion_materials.urdf.xacro
     @brief Material and color definitions used across the ORION URDF. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Equivalent to RGB(0, 79, 148) -->
    <material name="ArduinoBlue">
        <color rgba="0.0 0.31 0.58 1.0"/>
    </material>

    <!-- Equivalent to RGB(26, 127, 26) -->
    <material name="RaspberryGreen">
        <color rgba="0.1 0.5 0.1 1.0"/>
    </material>

    <!-- Equivalent to RGB(179, 26, 26) -->
    <material name="DriverRed">
        <color rgba="0.7 0.1 0.1 1.0"/>
    </material>

    <!-- Equivalent to RGB(26, 26, 26) -->
    <material name="SoftBlack">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>

    <!-- Equivalent to RGB(255, 255, 255) -->
    <material name="PureWhite">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <!-- Equivalent to RGB(240, 240, 225) -->
    <material name="PLAWhite">
        <color rgba="0.95 0.95 0.90 1.0"/>
    </material>

    <!-- Equivalent to RGB(181, 165, 66) -->
    <material name="Brass">
        <color rgba="0.71 0.65 0.26 1.0"/>
    </material>

    <!-- Equivalent to RGB(212, 173, 54) -->
    <material name="Gold">
        <color rgba="0.83 0.68 0.21 1.0"/>
    </material>

    <!-- Equivalent to RGB(128, 128, 128) -->
    <material name="MetalGray">
        <color rgba="0.5 0.5 0.5 1.0"/>
    </material>

    <!-- Equivalent to RGB(39, 39, 39) -->
    <material name="TransparentBlack">
        <color rgba="0.3 0.3 0.3 0.8"/>
    </material>

    <!-- Equivalent to RGB(141, 141, 141) -->
    <material name="PLAGray">
        <color rgba="0.6 0.6 0.6 1.0"/>
    </material>

    <!-- Equivalent to RGB(187, 133, 89) -->
    <material name="MDF">
        <color rgba="0.72 0.52 0.35 1.0"/>
    </material>

    <!-- Selects the visual material for structural panels based on the global
         ${color} property. Supported values: 'mdf', 'transparent', 'pla', 'gold'. -->
    <xacro:macro name="apply_color_material">
        <xacro:if value="${color == 'mdf'}">
            <material name="MDF"/>
        </xacro:if>
        <xacro:if value="${color == 'transparent'}">
            <material name="TransparentBlack"/>
        </xacro:if>
        <xacro:if value="${color == 'pla'}">
            <material name="PLAWhite"/>
        </xacro:if>
        <xacro:if value="${color == 'gold'}">
            <material name="Gold"/>
        </xacro:if>
    </xacro:macro>

</robot>
